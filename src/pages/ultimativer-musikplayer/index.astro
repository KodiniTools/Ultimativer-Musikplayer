---
/**
 * Ultimativer Musikplayer – Landingpage (statisch, SEO-optimiert)
 * i18n via data-i18n Attribute, synchronisiert mit SSI-Navigation language-changed Event.
 * Übersetzungen kommen aus den gemeinsamen Locale-Dateien (Single Source of Truth).
 */
import '../../assets/styles/main.css'
import de from '../../components/vue/ultimativer-musikplayer/i18n/locales/de.js'
import en from '../../components/vue/ultimativer-musikplayer/i18n/locales/en.js'
const t = de
---

<html lang="de">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f6f5f1" />
  <!-- Theme vor dem ersten Paint setzen (Tokens: Dark auf :root, Light über
       data-theme), damit Light-Nutzer keinen dunklen Flash sehen. Danach
       übernehmen SSI-Navigation bzw. der Settings-Store der App. -->
  <script is:inline>
    try {
      var storedTheme = localStorage.getItem('theme') === 'dark' ? 'dark' : 'light'
      document.documentElement.setAttribute('data-theme', storedTheme)
      document.documentElement.classList.toggle('dark', storedTheme === 'dark')
      var themeMeta = document.querySelector('meta[name="theme-color"]')
      if (themeMeta) themeMeta.setAttribute('content', storedTheme === 'dark' ? '#0a1324' : '#f6f5f1')
    } catch {
      document.documentElement.setAttribute('data-theme', 'light')
    }
  </script>

  <title>Ultimativer Musikplayer – Kostenloser Online-Audioplayer | KodiniTools</title>
  <meta name="description" content="Kostenloser Online-Musikplayer mit 7 Audio-Visualisierungsmodi, Playlist-Management und Equalizer. Unterstützt MP3, WAV, FLAC, M4A, OGG. Keine Registrierung nötig." />
  <meta name="keywords" content="Musikplayer, Audio Visualizer, Online Player, MP3 Player, kostenlos, Equalizer, Playlist" />

  <link rel="canonical" href="https://kodinitools.com/ultimativer-musikplayer/" />

  <!-- Sitemap -->
  <link rel="sitemap" type="application/xml" href="/ultimativer-musikplayer/sitemap.xml" />

  <!-- Open Graph -->
  <meta property="og:title" content="Ultimativer Musikplayer – KodiniTools" />
  <meta property="og:description" content="Erleben Sie Musik auf eine völlig neue Art mit fortschrittlicher Audio-Visualisierung, Playlist-Funktionen und modernem Design." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://kodinitools.com/ultimativer-musikplayer/" />

  <!-- Font Awesome (lokal) -->
  <link rel="stylesheet" href="/fontawesome/css/fontawesome.min.css" />
  <link rel="stylesheet" href="/fontawesome/css/solid.min.css" />

  <style>
    /* Landing-Page: Karten auf Fläche 1 mit Rahmen, Hover nur Rahmenfarbe;
       Gold füllt nur die Hauptaktion. Tokens: src/design-system/tokens-v2.css */
    .landing {
      max-width: 960px;
      margin: 0 auto;
      padding: var(--ds-space-8) var(--ds-space-4) var(--ds-space-12);
      display: grid;
      gap: var(--ds-space-8);
    }

    .hero {
      padding: var(--ds-space-12) var(--ds-space-6);
      background: var(--ds-surface-1);
      border: var(--ds-border-width) solid var(--ds-border);
      border-radius: var(--ds-radius-lg);
      text-align: center;
    }

    /* hero: 32 px, größer gibt es nichts */
    .hero h1 {
      margin-bottom: var(--ds-space-4);
      font-size: var(--ds-text-3xl);
    }

    .hero p {
      max-width: 640px;
      margin: 0 auto var(--ds-space-6);
      color: var(--ds-text-2);
      font-size: var(--ds-text-lg);
    }

    /* Button primary, Größe lg */
    .cta-button {
      display: inline-flex;
      align-items: center;
      gap: var(--ds-space-2);
      height: var(--ds-control-lg);
      padding: 0 var(--ds-space-5);
      border: var(--ds-border-width) solid var(--ds-accent);
      border-radius: var(--ds-radius-md);
      background: var(--ds-accent);
      color: var(--ds-on-accent);
      font-size: var(--ds-text-md);
      font-weight: var(--ds-weight-semibold);
      line-height: 1;
      text-decoration: none;
      transition:
        background-color var(--ds-duration) var(--ds-ease),
        border-color var(--ds-duration) var(--ds-ease);
    }

    .cta-button:hover {
      border-color: var(--ds-accent-hover);
      background: var(--ds-accent-hover);
    }

    /* Wiederholung am Seitenende: Button secondary, damit Gold einmal bleibt */
    .cta-button--secondary {
      border-color: var(--ds-border-strong);
      background: var(--ds-surface-2);
      color: var(--ds-text);
    }

    .cta-button--secondary:hover {
      border-color: var(--ds-border-strong);
      background: var(--ds-surface-3);
    }

    .cta-text {
      margin-bottom: var(--ds-space-5);
    }

    .features-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
      gap: var(--ds-space-3);
    }

    .feature-card {
      padding: var(--ds-space-5);
      background: var(--ds-surface-1);
      border: var(--ds-border-width) solid var(--ds-border);
      border-radius: var(--ds-radius-md);
      transition: border-color var(--ds-duration) var(--ds-ease);
    }

    .feature-card:hover {
      border-color: var(--ds-border-strong);
    }

    .feature-card i {
      display: grid;
      place-items: center;
      width: var(--ds-space-10);
      height: var(--ds-space-10);
      margin-bottom: var(--ds-space-3);
      border: var(--ds-border-width) solid var(--ds-border);
      border-radius: var(--ds-radius-md);
      background: var(--ds-surface-2);
      color: var(--ds-text-2);
      font-size: var(--ds-icon-md);
    }

    .feature-card h3 {
      margin-bottom: var(--ds-space-1);
      color: var(--ds-text);
      font-size: var(--ds-text-lg);
      font-weight: var(--ds-weight-semibold);
    }

    .feature-card p {
      color: var(--ds-text-2);
      font-size: var(--ds-text-md);
    }

    /* section-title: 20, fett */
    .section-title {
      margin-bottom: var(--ds-space-5);
      color: var(--ds-text);
      font-size: var(--ds-text-xl);
      font-weight: var(--ds-weight-bold);
      line-height: var(--ds-leading-tight);
      text-align: center;
    }

    @media (max-width: 480px) {
      .landing {
        padding: var(--ds-space-4) var(--ds-space-2) var(--ds-space-8);
        gap: var(--ds-space-6);
      }

      .hero {
        padding: var(--ds-space-8) var(--ds-space-4);
      }

      .hero h1 {
        font-size: var(--ds-text-2xl);
      }
    }
  </style>
</head>
<body>
  <script is:inline>
    document.body.classList.toggle(
      'light-theme',
      document.documentElement.getAttribute('data-theme') !== 'dark'
    )
  </script>
  <!--#include virtual="/partials/nav.html" -->

  <main class="landing ds-app">
    <!-- Hero Section -->
    <section class="hero">
      <h1 data-i18n="hero.title">{t.hero.title}</h1>
      <p data-i18n="hero.desc">{t.hero.desc}</p>
      <a href="/ultimativer-musikplayer/app/" class="cta-button">
        <i class="fa-solid fa-play"></i>
        <span data-i18n="hero.cta">{t.hero.cta}</span>
      </a>
    </section>

    <!-- Hauptfeatures -->
    <section>
      <h2 class="section-title" data-i18n="features.title">{t.features.title}</h2>
      <div class="features-grid">
        <div class="feature-card">
          <i class="fa-solid fa-wave-square"></i>
          <h3 data-i18n="features.viz.title">{t.features.viz.title}</h3>
          <p data-i18n="features.viz.desc">{t.features.viz.desc}</p>
        </div>

        <div class="feature-card">
          <i class="fa-solid fa-sliders"></i>
          <h3 data-i18n="features.eq.title">{t.features.eq.title}</h3>
          <p data-i18n="features.eq.desc">{t.features.eq.desc}</p>
        </div>

        <div class="feature-card">
          <i class="fa-solid fa-list"></i>
          <h3 data-i18n="features.playlist.title">{t.features.playlist.title}</h3>
          <p data-i18n="features.playlist.desc">{t.features.playlist.desc}</p>
        </div>

        <div class="feature-card">
          <i class="fa-solid fa-mobile-screen"></i>
          <h3 data-i18n="features.responsive.title">{t.features.responsive.title}</h3>
          <p data-i18n="features.responsive.desc">{t.features.responsive.desc}</p>
        </div>

        <div class="feature-card">
          <i class="fa-solid fa-circle-half-stroke"></i>
          <h3 data-i18n="features.theme.title">{t.features.theme.title}</h3>
          <p data-i18n="features.theme.desc">{t.features.theme.desc}</p>
        </div>

        <div class="feature-card">
          <i class="fa-solid fa-lock"></i>
          <h3 data-i18n="features.free.title">{t.features.free.title}</h3>
          <p data-i18n="features.free.desc">{t.features.free.desc}</p>
        </div>
      </div>
    </section>

    <!-- FAQ Section -->
    <section class="content-section">
      <h2 class="section-title" data-i18n="faq.title">{t.faq.title}</h2>

      <div class="faq-item">
        <button class="faq-question" onclick="this.nextElementSibling.classList.toggle('open'); this.querySelector('.faq-icon').classList.toggle('open')">
          <span data-i18n="faq.formats.question">{t.faq.formats.question}</span>
          <i class="fa-solid fa-chevron-down faq-icon"></i>
        </button>
        <div class="faq-answer">
          <p data-i18n="faq.formats.answer">{t.faq.formats.answer}</p>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question" onclick="this.nextElementSibling.classList.toggle('open'); this.querySelector('.faq-icon').classList.toggle('open')">
          <span data-i18n="faq.free.question">{t.faq.free.question}</span>
          <i class="fa-solid fa-chevron-down faq-icon"></i>
        </button>
        <div class="faq-answer">
          <p data-i18n="faq.free.answer">{t.faq.free.answer}</p>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question" onclick="this.nextElementSibling.classList.toggle('open'); this.querySelector('.faq-icon').classList.toggle('open')">
          <span data-i18n="faq.visualization.question">{t.faq.visualization.question}</span>
          <i class="fa-solid fa-chevron-down faq-icon"></i>
        </button>
        <div class="faq-answer">
          <p data-i18n="faq.visualization.answer">{t.faq.visualization.answer}</p>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question" onclick="this.nextElementSibling.classList.toggle('open'); this.querySelector('.faq-icon').classList.toggle('open')">
          <span data-i18n="faq.mobile.question">{t.faq.mobile.question}</span>
          <i class="fa-solid fa-chevron-down faq-icon"></i>
        </button>
        <div class="faq-answer">
          <p data-i18n="faq.mobile.answer">{t.faq.mobile.answer}</p>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question" onclick="this.nextElementSibling.classList.toggle('open'); this.querySelector('.faq-icon').classList.toggle('open')">
          <span data-i18n="faq.privacy.question">{t.faq.privacy.question}</span>
          <i class="fa-solid fa-chevron-down faq-icon"></i>
        </button>
        <div class="faq-answer">
          <p data-i18n="faq.privacy.answer">{t.faq.privacy.answer}</p>
        </div>
      </div>

      <div class="faq-item">
        <button class="faq-question" onclick="this.nextElementSibling.classList.toggle('open'); this.querySelector('.faq-icon').classList.toggle('open')">
          <span data-i18n="faq.upload_limit.question">{t.faq.upload_limit.question}</span>
          <i class="fa-solid fa-chevron-down faq-icon"></i>
        </button>
        <div class="faq-answer">
          <p data-i18n="faq.upload_limit.answer">{t.faq.upload_limit.answer}</p>
        </div>
      </div>
    </section>

    <!-- CTA Bottom -->
    <section class="hero">
      <p class="cta-text" data-i18n="cta.text">{t.cta.text}</p>
      <a href="/ultimativer-musikplayer/app/" class="cta-button cta-button--secondary">
        <i class="fa-solid fa-headphones"></i>
        <span data-i18n="cta.button">{t.cta.button}</span>
      </a>
    </section>
  </main>

  <!--#include virtual="/partials/footer.html" -->
  <!--#include virtual="/partials/cookie-banner.html" -->

  <script>
    import { initStaticPartialSync } from '../../components/vue/ultimativer-musikplayer/utils/ssiNav.js'
    initStaticPartialSync()
  </script>

  <script define:vars={{ translations: { de, en } }}>
    (function () {
      function get(obj, path) {
        return path.split('.').reduce(function (o, k) { return o && o[k] }, obj)
      }

      function applyLang(lang) {
        var strings = translations[lang] || translations.de
        var elements = document.querySelectorAll('[data-i18n]')
        for (var i = 0; i < elements.length; i++) {
          var key = elements[i].getAttribute('data-i18n')
          var val = get(strings, key)
          if (val) elements[i].textContent = val
        }
        document.documentElement.lang = lang
      }

      var saved = localStorage.getItem('locale') || 'de'
      if (saved !== 'de') applyLang(saved)

      document.addEventListener('click', function (e) {
        var btn = e.target.closest('.global-nav-lang-btn')
        if (!btn) return
        var lang = btn.getAttribute('data-lang')
        if (lang) applyLang(lang)
      })

      window.addEventListener('locale-changed', function (e) {
        var lang = e.detail && e.detail.locale
        if (lang) applyLang(lang)
      })
    })()
  </script>
</body>
</html>