---
/**
 * Ultimativer Musikplayer – Landingpage (statisch, SEO-optimiert)
 * i18n via data-i18n Attribute, synchronisiert mit SSI-Navigation language-changed Event.
 * Übersetzungen kommen aus den gemeinsamen Locale-Dateien (Single Source of Truth).
 */
import '../../assets/styles/main.css'
import '../../design-system/tokens-normalizer.css'
import '../../assets/styles/kodini-header-stage2.css'
import '../../assets/styles/kodini-landing.css'
import de from '../../components/vue/ultimativer-musikplayer/i18n/locales/de.js'
import en from '../../components/vue/ultimativer-musikplayer/i18n/locales/en.js'
import { pageMeta } from '../../config/pageMeta.js'
import heroSmall from '../../assets/images/music-listening-560.webp'
import heroLarge from '../../assets/images/music-listening-1120.webp'
const t = de

---

<html lang="de" class="kodini-player-page kodini-player-page--landing">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="theme-color" content="#f6f5f1" />
  <!-- Theme vor dem ersten Paint setzen (Tokens: Dark auf :root, Light über
       data-theme), damit Light-Nutzer keinen dunklen Flash sehen. Danach
       übernehmen SSI-Navigation bzw. der Settings-Store der App. -->
  <script is:inline>
    try {
      var storedTheme = localStorage.getItem('theme') === 'dark' ? 'dark' : 'light'
      document.documentElement.setAttribute('data-theme', storedTheme)
      document.documentElement.classList.toggle('dark', storedTheme === 'dark')
      var themeMeta = document.querySelector('meta[name="theme-color"]')
      if (themeMeta) themeMeta.setAttribute('content', storedTheme === 'dark' ? '#0a1324' : '#f6f5f1')
    } catch {
      document.documentElement.setAttribute('data-theme', 'light')
    }
  </script>

  <title>MP3 Player online – Musikplayer mit Visualizer | KodiniTools</title>
  <meta name="description" content="MP3 Player online und kostenlos: Musik im Browser abspielen mit 7 Visualisierungen, Playlist und Equalizer. Für MP3, WAV, FLAC, M4A, OGG. Ohne Registrierung." />
  <meta name="keywords" content="MP3 Player online, Musikplayer im Browser, lokale Musik abspielen, Audio Player online, Visualizer, Equalizer, Playlist, kostenlos" />

  <link rel="canonical" href="https://kodinitools.com/ultimativer-musikplayer/" />
  <link rel="alternate" hreflang="de" href="https://kodinitools.com/ultimativer-musikplayer/" />
  <link rel="alternate" hreflang="en" href="https://kodinitools.com/ultimativer-musikplayer/?lang=en" />
  <link rel="alternate" hreflang="x-default" href="https://kodinitools.com/ultimativer-musikplayer/" />

  <!-- Sitemap -->
  <link rel="sitemap" type="application/xml" href="/ultimativer-musikplayer/sitemap.xml" />

  <!-- Open Graph -->
  <meta property="og:title" content="MP3 Player online – Musikplayer mit Visualizer" />
  <meta property="og:description" content="MP3 Player online und kostenlos: Musik im Browser abspielen mit 7 Visualisierungen, Playlist und Equalizer. Für MP3, WAV, FLAC, M4A, OGG. Ohne Registrierung." />
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://kodinitools.com/ultimativer-musikplayer/" />

  <!-- Font Awesome (lokal) -->
  <link rel="stylesheet" href="/fontawesome/css/fontawesome.min.css" />
  <link rel="stylesheet" href="/fontawesome/css/solid.min.css" />

  <!-- Vorschaubild beim Teilen (1200×630) -->
  <meta property="og:image" content="https://kodinitools.com/image/kodinitools-og-image.jpg" />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content="https://kodinitools.com/image/kodinitools-og-image.jpg" />
</head>
<body>
  <script is:inline>
    document.body.classList.toggle(
      'light-theme',
      document.documentElement.getAttribute('data-theme') !== 'dark'
    )
  </script>
  <!--#include virtual="/partials/nav.html" -->

  <main class="landing-page ds-app">
    <!-- Hero: Text links, Bildrahmen rechts (unter 761 px untereinander) -->
    <section class="hero">
      <div class="container">
        <div class="hero-content">
          <h1 class="hero-title">
            <span class="hero-title__accent" data-i18n="hero.titleAccent">{t.hero.titleAccent}</span>{' '}
            <span class="hero-title__main" data-i18n="hero.titleMain">{t.hero.titleMain}</span>
          </h1>
          <p class="hero-subtitle" data-i18n="hero.subtitle">{t.hero.subtitle}</p>
          <p class="hero-description" data-i18n="hero.desc">{t.hero.desc}</p>
          <a href="/ultimativer-musikplayer/app/" class="btn-hero">
            <span data-i18n="hero.cta">{t.hero.cta}</span>
          </a>
        </div>
        <figure class="hero-media">
          <img
            class="hero-image"
            src={heroLarge.src}
            srcset={`${heroSmall.src} ${heroSmall.width}w, ${heroLarge.src} ${heroLarge.width}w`}
            sizes="(min-width: 1200px) 576px, (min-width: 761px) 50vw, 94vw"
            width="1120"
            height="630"
            alt=""
            fetchpriority="high"
          />
        </figure>
      </div>
    </section>

    <!-- Hauptfunktionen -->
    <section id="features" class="features">
      <div class="container">
        <h2 class="section-title" data-i18n="features.title">{t.features.title}</h2>
        <div class="features-grid">
          <div class="feature-card">
            <div class="feature-icon"><i class="fa-solid fa-wave-square" aria-hidden="true"></i></div>
            <h3 data-i18n="features.viz.title">{t.features.viz.title}</h3>
            <p data-i18n="features.viz.desc">{t.features.viz.desc}</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon"><i class="fa-solid fa-sliders" aria-hidden="true"></i></div>
            <h3 data-i18n="features.eq.title">{t.features.eq.title}</h3>
            <p data-i18n="features.eq.desc">{t.features.eq.desc}</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon"><i class="fa-solid fa-list" aria-hidden="true"></i></div>
            <h3 data-i18n="features.playlist.title">{t.features.playlist.title}</h3>
            <p data-i18n="features.playlist.desc">{t.features.playlist.desc}</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon"><i class="fa-solid fa-mobile-screen" aria-hidden="true"></i></div>
            <h3 data-i18n="features.responsive.title">{t.features.responsive.title}</h3>
            <p data-i18n="features.responsive.desc">{t.features.responsive.desc}</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon"><i class="fa-solid fa-circle-half-stroke" aria-hidden="true"></i></div>
            <h3 data-i18n="features.theme.title">{t.features.theme.title}</h3>
            <p data-i18n="features.theme.desc">{t.features.theme.desc}</p>
          </div>
          <div class="feature-card">
            <div class="feature-icon"><i class="fa-solid fa-lock" aria-hidden="true"></i></div>
            <h3 data-i18n="features.free.title">{t.features.free.title}</h3>
            <p data-i18n="features.free.desc">{t.features.free.desc}</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" class="faq">
      <div class="container">
        <h2 class="section-title" data-i18n="faq.title">{t.faq.title}</h2>
        <div class="faq-list">
          <div class="faq-item">
            <button class="faq-question" type="button" aria-expanded="false">
              <span data-i18n="faq.formats.question">{t.faq.formats.question}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
            <div class="faq-answer" hidden>
              <p data-i18n="faq.formats.answer">{t.faq.formats.answer}</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-question" type="button" aria-expanded="false">
              <span data-i18n="faq.free.question">{t.faq.free.question}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
            <div class="faq-answer" hidden>
              <p data-i18n="faq.free.answer">{t.faq.free.answer}</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-question" type="button" aria-expanded="false">
              <span data-i18n="faq.visualization.question">{t.faq.visualization.question}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
            <div class="faq-answer" hidden>
              <p data-i18n="faq.visualization.answer">{t.faq.visualization.answer}</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-question" type="button" aria-expanded="false">
              <span data-i18n="faq.mobile.question">{t.faq.mobile.question}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
            <div class="faq-answer" hidden>
              <p data-i18n="faq.mobile.answer">{t.faq.mobile.answer}</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-question" type="button" aria-expanded="false">
              <span data-i18n="faq.privacy.question">{t.faq.privacy.question}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
            <div class="faq-answer" hidden>
              <p data-i18n="faq.privacy.answer">{t.faq.privacy.answer}</p>
            </div>
          </div>
          <div class="faq-item">
            <button class="faq-question" type="button" aria-expanded="false">
              <span data-i18n="faq.upload_limit.question">{t.faq.upload_limit.question}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
            <div class="faq-answer" hidden>
              <p data-i18n="faq.upload_limit.answer">{t.faq.upload_limit.answer}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Schluss-Aufruf -->
    <section class="cta">
      <div class="container">
        <p class="cta-text" data-i18n="cta.text">{t.cta.text}</p>
        <a href="/ultimativer-musikplayer/app/" class="btn-hero btn-hero--secondary">
          <i class="fa-solid fa-headphones" aria-hidden="true"></i>
          <span data-i18n="cta.button">{t.cta.button}</span>
        </a>
      </div>
    </section>
  </main>

  <!--#include virtual="/partials/footer.html" -->
  <!--#include virtual="/partials/cookie-banner.html" -->

  <script>
    // FAQ: Antwort ein-/ausblenden, aria-expanded und Symbol (+/−) nachführen
    document.querySelectorAll('.faq-item').forEach((item) => {
      const button = item.querySelector('.faq-question')
      const answer = item.querySelector('.faq-answer')
      const icon = item.querySelector('.faq-icon')
      button?.addEventListener('click', () => {
        const open = button.getAttribute('aria-expanded') !== 'true'
        button.setAttribute('aria-expanded', String(open))
        answer?.toggleAttribute('hidden', !open)
        item.classList.toggle('faq-open', open)
        if (icon) icon.textContent = open ? '−' : '+'
      })
    })
  </script>

  <script>
    import { initStaticPartialSync } from '../../components/vue/ultimativer-musikplayer/utils/ssiNav.js'
    initStaticPartialSync()
  </script>

  <script define:vars={{ translations: { de, en }, pageMeta }}>
    (function () {
      function get(obj, path) {
        return path.split('.').reduce(function (o, k) { return o && o[k] }, obj)
      }

      function applyLang(lang) {
        var strings = translations[lang] || translations.de
        var elements = document.querySelectorAll('[data-i18n]')
        for (var i = 0; i < elements.length; i++) {
          var key = elements[i].getAttribute('data-i18n')
          var val = get(strings, key)
          if (val) elements[i].textContent = val
        }
        applyHead(lang)
      }

      // Titel, Beschreibung, Canonical (EN = ?lang=en) und Sprache des Dokuments.
      function applyHead(lang) {
        var meta = pageMeta[lang] || pageMeta.de
        var url = lang === 'en' ? pageMeta.url + '?lang=en' : pageMeta.url
        document.documentElement.lang = lang === 'en' ? 'en' : 'de'
        document.title = meta.title
        var set = function (selector, attr, value) {
          var el = document.querySelector(selector)
          if (el) el.setAttribute(attr, value)
        }
        set('meta[name="description"]', 'content', meta.description)
        set('link[rel="canonical"]', 'href', url)
        set('meta[property="og:url"]', 'content', url)
      }

      function readStored() {
        try {
          return localStorage.getItem('locale')
        } catch {
          return null
        }
      }

      // ?lang=de|en (hreflang-Ziel) hat Vorrang vor der gespeicherten Sprache.
      var fromUrl = new URLSearchParams(location.search).get('lang')
      var stored = readStored()
      var saved =
        fromUrl === 'de' || fromUrl === 'en' ? fromUrl : stored === 'en' ? 'en' : 'de'
      try {
        localStorage.setItem('locale', saved)
      } catch {
        // Speicher gesperrt: Sprache gilt nur für diesen Aufruf.
      }
      if (saved !== 'de') applyLang(saved)

      document.addEventListener('click', function (e) {
        var btn = e.target.closest('.global-nav-lang-btn')
        if (!btn) return
        var lang = btn.getAttribute('data-lang')
        if (lang) applyLang(lang)
      })

      window.addEventListener('locale-changed', function (e) {
        var lang = e.detail && e.detail.locale
        if (lang) applyLang(lang)
      })
    })()
  </script>
</body>
</html>